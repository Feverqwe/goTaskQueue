{
  "name": "task-list",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:dist": "del-cli ./dist/**",
    "clean:www": "del-cli --force ../assets/www",
    "copy:dist": "ncp ./dist ../assets/www",
    "build": "rspack build --mode production",
    "dev": "rspack build --mode development --watch",
    "release": "npm run clean:dist && npm run build && npm run clean:www && npm run copy:dist",
    "tsc": "tsc --noEmit",
    "lint": "npx eslint ./src && npm run prettier",
    "prettier": "npx prettier --check ./src",
    "prettier:fix": "npx prettier --write ./src",
    "lint:fix": "npx eslint --fix ./src && npm run prettier:fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/cache": "^11.10.5",
    "@emotion/react": "^11.6.0",
    "@emotion/styled": "^11.6.0",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "@mui/system": "^7",
    "lodash.throttle": "^4.1.1",
    "mobx": "^6.6.2",
    "mobx-react-lite": "^4.0.3",
    "monaco-editor": "^0.54.0",
    "path-browserify": "^1.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "xterm": "^5.0.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@rspack/cli": "^2.1.8",
    "@rspack/core": "^2.1.8",
    "@types/lodash.throttle": "^4.1.7",
    "@types/path-browserify": "^1.0.0",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "del-cli": "^6.0.0",
    "eslint": "^8.27.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "ncp": "^2.0.0",
    "prettier": "^3.0.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "eslint-config-airbnb": {
      "eslint-plugin-react-hooks": "$eslint-plugin-react-hooks"
    }
  }
}
