{
  "name": "task-list",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:dist": "del-cli ./dist/**",
    "clean:www": "del-cli --force ../assets/www",
    "copy:dist": "ncp ./dist ../assets/www",
    "build": "rspack build --mode production",
    "dev": "rspack build --mode development --watch",
    "release": "npm run clean:dist && npm run build && npm run clean:www && npm run copy:dist",
    "tsc": "tsc --noEmit",
    "lint": "npx eslint ./src && npm run prettier",
    "prettier": "npx prettier --check ./src",
    "prettier:fix": "npx prettier --write ./src",
    "lint:fix": "npx eslint --fix ./src && npm run prettier:fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lodash.throttle": "^4.1.1",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "monaco-editor": "^0.56.0",
    "path-browserify": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@gravity-ui/eslint-config": "^4.3.2",
    "@rspack/cli": "^2.1.8",
    "@rspack/core": "^2.1.8",
    "@types/lodash.throttle": "^4.1.9",
    "@types/path-browserify": "^1.0.3",
    "@types/react-dom": "^19.2.4",
    "del-cli": "^6.0.0",
    "eslint": "^9.0.0",
    "ncp": "^2.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  }
}
